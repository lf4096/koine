# Live-test credentials. Copy to .env and fill in; tests skip when unset.
# BASE_URL vars are optional: leave empty for the provider's default endpoint.
KOINE_TEST_ANTHROPIC_API_KEY=
KOINE_TEST_ANTHROPIC_BASE_URL=
KOINE_TEST_ANTHROPIC_MODEL=claude-sonnet-4-5

KOINE_TEST_OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint (DeepSeek, Kimi, Qwen, ...).
KOINE_TEST_OPENAI_BASE_URL=
# Responses API model; leave empty for endpoints without /responses.
KOINE_TEST_OPENAI_MODEL=gpt-5.4-mini
KOINE_TEST_OPENAI_CHAT_MODEL=gpt-4.1-mini
KOINE_TEST_OPENAI_EMBED_MODEL=text-embedding-3-small
KOINE_TEST_OPENAI_TTS_MODEL=gpt-4o-mini-tts
KOINE_TEST_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
KOINE_TEST_OPENAI_IMAGE_MODEL=gpt-image-1-mini

KOINE_TEST_GEMINI_API_KEY=
KOINE_TEST_GEMINI_BASE_URL=
KOINE_TEST_GEMINI_MODEL=gemini-2.5-flash

# Vertex-style gateway (bearer auth); leave BEARER empty to skip.
KOINE_TEST_VERTEX_BEARER=
KOINE_TEST_VERTEX_BASE_URL=
KOINE_TEST_VERTEX_API_VERSION=
KOINE_TEST_VERTEX_EMBED_MODEL=gemini-embedding-001
KOINE_TEST_VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
